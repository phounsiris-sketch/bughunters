rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who is asking ─────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    // The one Super Admin (verified email). Can do everything and is the
    // only person who can grant permissions.
    function isSuper() {
      return isAuth()
        && request.auth.token.get('email', '') == 'phounsiri.s@aidctech.com.la'
        && request.auth.token.get('email_verified', false) == true;
    }

    // Permissions granted by the Super Admin, stored on users/{uid}.perms:
    // Everyone creates and manages their OWN polls and sessions. Extra:
    //   createPoll  — manage everyone's polls (confirm / cancel / delete)
    //   editSession — date, time, court, players of any session; delete any
    //   editBill    — costs, payers, dinner, receipts, payments of any session
    //   editConfig  — courts, cocks, manual players, group settings
    function can(p) {
      return isSuper() || (isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('perms', {}).get(p, false) == true);
    }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // The person who created a poll / session always manages it
    function isCreator() { return isAuth() && resource.data.get('createdBy', '') == request.auth.uid; }
    function isManual(data) { return data.get('manual', false) == true; }

    // ── Players ───────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      // Your own profile, without permissions; or a manual player (editConfig)
      allow create: if (isOwner(uid) && !('perms' in request.resource.data))
        || (can('editConfig') && isManual(request.resource.data) && !('perms' in request.resource.data))
        || isSuper();
      // You may edit your profile but never your own permissions
      allow update: if (isOwner(uid) && !changed().hasAny(['perms', 'manual']))
        || (can('editConfig') && isManual(resource.data) && isManual(request.resource.data) && !changed().hasAny(['perms']))
        || isSuper();
      allow delete: if (can('editConfig') && isManual(resource.data)) || isSuper();
    }

    // ── Polls ─────────────────────────────────────────────────
    match /polls/{pollId} {
      allow read: if isAuth();
      // Everyone can create a poll of their own; createPoll may restore anyone's
      allow create: if (isAuth() && request.resource.data.get('createdBy', '') == request.auth.uid) || can('createPoll');
      // Everyone can answer; the creator manages it; createPoll manages all polls
      // Answers only before the voting deadline (closesAt, ms); the creator /
      // createPoll can still enter answers, confirm or cancel afterwards
      // Voting ends early when the plan is confirmed / cancelled, or at closesAt
      allow update: if (isAuth() && changed().hasOnly(['responses', 'votes', 'voteLog', 'reachedAt'])
                        && resource.data.get('status', 'draft') in ['draft', 'open']
                        && (!('closesAt' in resource.data) || request.time.toMillis() < resource.data.closesAt))
                    || can('createPoll') || isCreator();
      allow delete: if can('createPoll') || isCreator();
    }

    // ── Sessions ──────────────────────────────────────────────
    function sessionDetailKeys() {
      return ['date', 'time', 'duration', 'courtId', 'courtName', 'courtLocation', 'pricePerHour', 'players'];
    }
    function billKeys() {
      return ['courtCost', 'courtPayer', 'shuttlecocks', 'shuttleTotal', 'shuttlePayer', 'otherCosts',
              'otherTotal', 'dinner', 'grandTotal', 'calculated'];
    }

    match /sessions/{sessionId} {
      allow read: if isAuth();
      // Everyone can create a session of their own (from their own poll, or
      // standalone); createPoll / editSession may create one for anyone
      allow create: if can('createPoll') || can('editSession')
        || (isAuth() && request.resource.data.get('createdBy', '') == request.auth.uid
            && (request.resource.data.get('pollId', null) == null
                || get(/databases/$(database)/documents/polls/$(request.resource.data.pollId)).data.get('createdBy', '') == request.auth.uid));
      allow update: if isAuth() && (
        // The creator (the poll's creator for confirmed polls) edits everything
        isCreator()
        // Marking a payment as paid is open to everyone
        || changed().hasOnly(['settled', 'settledAt', 'status'])
        || (
          (can('editSession') || !changed().hasAny(sessionDetailKeys())) &&
          (can('editBill') || !changed().hasAny(billKeys())) &&
          (can('editSession') || can('editBill'))
        )
      );
      allow delete: if can('editSession') || isCreator();

      match /dinner/{docId} {
        allow read: if isAuth();
        allow write: if can('editBill');
      }
    }

    // ── Configuration ─────────────────────────────────────────
    match /courts/{courtId} {
      allow read: if isAuth();
      allow write: if can('editConfig');
    }

    match /shuttlecocks/{id} {
      allow read: if isAuth();
      allow write: if can('editConfig');
    }

    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if can('editConfig');
    }

    // This user's push tokens (devices). The sender uses the Admin SDK.
    match /pushTokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Recently deleted (30 days). Only the person who deleted an item (or
    // the Super Admin) sees, restores or removes it. Restoring writes the
    // item back through the normal rules above. The sender purges old ones.
    match /trash/{id} {
      allow read, delete: if isSuper() || (isAuth() && resource.data.deletedBy == request.auth.uid);
      allow create: if isAuth() && request.resource.data.deletedBy == request.auth.uid;
    }

    // Big images (receipts) kept out of sessions; sessions store "img:<id>"
    match /images/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow delete: if isSuper() || (isAuth() && resource.data.createdBy == request.auth.uid);
    }

    // Payment QR codes: your own, or a manual player's (editConfig)
    match /qrcodes/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid)
        || (can('editConfig') && isManual(get(/databases/$(database)/documents/users/$(uid)).data))
        || isSuper();
    }
  }
}
