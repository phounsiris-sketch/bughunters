rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }

    // Registered players own their profile. Manual players (friends without
    // an account, `manual: true`) can be managed by any signed-in member,
    // but a manual entry can never be turned into, or replace, a real account.
    function isManual(data) { return data.get('manual', false) == true; }

    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid) || (isAuth() && isManual(request.resource.data));
      allow update: if isOwner(uid) || (isAuth() && isManual(resource.data) && isManual(request.resource.data));
      allow delete: if isAuth() && isManual(resource.data);
    }

    match /polls/{pollId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
    }

    match /sessions/{sessionId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();

      match /dinner/{docId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
    }

    match /courts/{courtId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /shuttlecocks/{id} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
  }
}
